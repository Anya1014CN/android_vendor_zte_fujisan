service fujisan-display-setup /vendor/bin/init.fujisan.display.sh
    class core
    seclabel u:r:init:s0
    user root
    group root graphics input system
    disabled
    oneshot

service fujisan-brightness-sync /vendor/bin/init.fujisan.display.sh --watch-brightness
    class main
    seclabel u:r:init:s0
    user root
    group root graphics system
    disabled

on early-boot
    start fujisan-display-setup

on property:init.svc.surfaceflinger=running
    start fujisan-display-setup

on property:sys.boot_completed=1
    start fujisan-display-setup
    start fujisan-brightness-sync

on property:persist.vendor.fujisan.display_mode=*
    start fujisan-display-setup

on property:persist.vendor.fujisan.single_display_id=*
    start fujisan-display-setup

on property:persist.vendor.fujisan.force_dual_screen=*
    start fujisan-display-setup

on property:persist.vendor.fujisan.secondary_backlight=*
    start fujisan-display-setup

on property:persist.sys.zte.hallStatus=*
    start fujisan-display-setup
