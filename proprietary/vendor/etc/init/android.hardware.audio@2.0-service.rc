# Android 11 ships the real audio HAL entry point from
# android.hardware.audio.service.rc as "vendor.audio-hal".
# Keep the legacy service names and interface map alive so audioserver and
# hwservicemanager can still trigger that source-built service.
service vendor.audio-hal-4-0-msd /system/bin/setprop ctl.start vendor.audio-hal
    class hal
    disabled
    oneshot

service vendor.audio-hal-2-0 /system/bin/setprop ctl.start vendor.audio-hal
    interface android.hardware.audio@2.0::IDevicesFactory default
    interface android.hardware.audio.effect@2.0::IEffectsFactory default
    class hal
    disabled
    oneshot

service audio-hal-2-0 /system/bin/setprop ctl.start vendor.audio-hal
    class hal
    disabled
    oneshot
