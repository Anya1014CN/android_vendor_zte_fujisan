service ril-daemon /vendor/bin/hw/rild
    class main
    socket rild stream 660 root radio
    socket rild-debug stream 660 radio system
    user radio
    group radio cache inet misc audio sdcard_r sdcard_rw diag oem_2901 log
    capabilities BLOCK_SUSPEND NET_ADMIN NET_RAW
    interface android.hardware.radio@1.1::IRadio slot1
    interface android.hardware.radio@1.1::ISap slot1
    interface android.hardware.radio.deprecated@1.0::IOemHook slot1
