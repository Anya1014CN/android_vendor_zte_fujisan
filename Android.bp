// VIDC uses the frame-metadata ABI implemented by Fujisan's OEM MSM8996
// gralloc stack. Declare the already-packaged ABI libraries for Soong so the
// source-built Qualcomm V4L2 OMX implementation can link against them.
cc_prebuilt_library_shared {
    name: "libqdMetaData",
    vendor: true,
    arch: {
        arm: {
            srcs: ["proprietary/vendor/lib/libqdMetaData.so"],
        },
        arm64: {
            srcs: ["proprietary/vendor/lib64/libqdMetaData.so"],
        },
    },
    strip: {
        none: true,
    },
    check_elf_files: false,
    installable: false,
}

cc_prebuilt_library_shared {
    name: "libqdutils",
    vendor: true,
    arch: {
        arm: {
            srcs: ["proprietary/vendor/lib/libqdutils.so"],
        },
        arm64: {
            srcs: ["proprietary/vendor/lib64/libqdutils.so"],
        },
    },
    strip: {
        none: true,
    },
    check_elf_files: false,
    installable: false,
}

// The stock FPC service uses Android 8's deprecated HIDL constructor-map ABI.
// Prefer this patched OEM binary over the generic AOSP 2.1 default service so
// Soong has exactly one owner for the installed vendor/hw destination.
cc_prebuilt_binary {
    name: "android.hardware.biometrics.fingerprint@2.1-service",
    srcs: ["proprietary/vendor/bin/hw/android.hardware.biometrics.fingerprint@2.1-service"],
    stem: "android.hardware.biometrics.fingerprint@2.1-service",
    vendor: true,
    relative_install_path: "hw",
    prefer: true,
    check_elf_files: false,
    strip: {
        none: true,
    },
    init_rc: ["proprietary/vendor/etc/init/fujisan.fingerprint.rc"],
}
